# Токен бота від @BotFather
BOT_TOKEN=123456:ABC-your-token
# Публічна HTTPS-адреса, за якою доступний цей сервер (потрібна для Mini App)
WEBAPP_URL=https://your-domain.example.com
# Telegram ID адміністраторів через кому (дізнатися свій ID: @userinfobot)
ADMIN_IDS=111111111
# Де зберігати базу та фото
DATA_DIR=./data
# 1 = відкривати Mini App у звичайному браузері без Telegram (тільки для розробки!)
DEV_MODE=0
# 0 = не запускати бота (тільки веб/API)
RUN_BOT=1
# Необов'язково: посилання для QR-кодів. За замовчуванням https://t.me/<бот>?startapp=
# Якщо створили окремий Mini App через /newapp: https://t.me/<бот>/<назва>?startapp=
APP_LINK=
